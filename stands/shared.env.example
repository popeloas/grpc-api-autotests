# Пример общего стенда: только чтение, без доступа к базе.
# Скопировать в stands/shared.env и указать адрес. Секреты (если нужны) — в stands/shared.secrets.env,
# этот файл в git не попадает.
CATALOG_GRPC=catalog.example.internal:443
ALLOW_WRITES=false
# DB_PATH не задан — тесты needs_db будут пропущены с причиной
